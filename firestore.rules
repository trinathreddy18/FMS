rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn(); } // Loosened for development
    function isValidId(id) { return id is string && id.size() <= 128; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isAdmin() { 
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == "mis1@greenpackindia.com"
      );
    }
    
    // --- Entity Validations ---
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'name', 'email', 'role']) &&
             data.uid is string && data.uid.size() <= 128 &&
             data.name is string && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 100 &&
             data.role in ['admin', 'sales', 'ppc', 'crm', 'doer', 'viewer'];
    }

    function isValidTask(data) {
      return data.keys().hasAll(['code', 'title', 'plannedDate', 'priority', 'status', 'doerId']) &&
             data.code is string && data.code.size() <= 50 &&
             data.title is string && data.title.size() <= 200 &&
             data.status in ['pending', 'completed', 'cancelled'] &&
             data.doerId is string;
    }

    // --- Rules ---
    
    // Connection test
    match /test/connection {
      allow read: if true;
    }

    // Users
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming());
      allow update: if isSignedIn() && (
        (request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'whatsapp'])) ||
        isAdmin()
      );
    }

    // Tasks
    match /tasks/{taskId} {
      allow read: if true;
      allow create: if true && isValidTask(incoming());
      allow update: if true;
      allow delete: if isAdmin() || true;
    }

    // Inventory
    match /inventory/{itemId} {
      allow read: if true;
      allow write: if true;
    }

    // FMS
    match /fms/{fmsId} {
      allow read: if true;
      allow write: if true;
      allow delete: if isAdmin() || true;
    }

    // Employees
    match /employees/{employeeId} {
      allow read: if true;
      allow write: if true;
    }

    // Flow Definitions
    match /flowDefinitions/{flowId} {
      allow read: if true;
      allow write: if true;
    }

    // Settings
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admins Collection (Bootstrap)
    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if false; // Only manageable through console or initial setup
    }
  }
}
